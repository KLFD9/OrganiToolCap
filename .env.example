# Le partage en direct fonctionne sur Vercel sans variable et sans compte.
# La découverte des participants est décentralisée ; le document reste échangé
# directement entre navigateurs et chiffré par la clé du lien.

# Route Vercel facultative qui génère des identifiants TURN temporaires après
# l’action explicite « Partager » ou « Rejoindre ». Utile seulement sur les
# réseaux d’entreprise qui bloquent les connexions directes WebRTC.
# VITE_COLLAB_TURN_CREDENTIALS_URL=/api/turn-credentials

# Variables serveur Vercel : ne jamais les préfixer par VITE_.
# COLLAB_ALLOWED_ORIGINS=https://organitool.votre-domaine.fr
# TURN_URLS=turn:turn.votre-domaine.fr:3478?transport=udp,turn:turn.votre-domaine.fr:3478?transport=tcp
# TURN_SHARED_SECRET=replace-with-at-least-32-random-bytes
# TURN_CREDENTIAL_TTL_SECONDS=600

# Repli facultatif pour le développement local uniquement.
# VITE_COLLAB_ICE_SERVERS_JSON=[{"urls":["stun:turn.example.com:3478"]}]
