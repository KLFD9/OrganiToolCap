# Relais WebSocket de signalisation, séparés par des virgules.
# À configurer dans Vercel pour remplacer le relais public de démonstration.
VITE_COLLAB_SIGNALING_URLS=wss://collaboration.example.com/signal

# Route Vercel qui génère des identifiants TURN temporaires après l’action
# explicite « Partager » ou « Rejoindre ».
VITE_COLLAB_TURN_CREDENTIALS_URL=/api/turn-credentials

# Variables serveur Vercel : ne jamais les préfixer par VITE_.
COLLAB_ALLOWED_ORIGINS=https://organitool.example.com
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_SHARED_SECRET=replace-with-at-least-32-random-bytes
TURN_CREDENTIAL_TTL_SECONDS=600

# Repli facultatif pour le développement local uniquement.
# VITE_COLLAB_ICE_SERVERS_JSON=[{"urls":["stun:turn.example.com:3478"]}]
